# ─── Dub Club configuration ─────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# Server
PORT=8787
HOST=0.0.0.0
# Where uploads and outputs live. Must be private (not web-served).
DATA_DIR=./data
# Public brand name (swap here if the name changes)
BRAND_NAME=Dub Club

# Limits
MAX_UPLOAD_MB=200
MAX_DURATION_SEC=600
MIN_DURATION_SEC=1
# Delete uploads + outputs after this many idle minutes
RETENTION_MINUTES=60
# Parallel jobs on this instance
WORKER_CONCURRENCY=1
# Max uploads a single browser session may hold at once
MAX_UPLOADS_PER_SESSION=5

# Engine: passthrough | remote | elevenlabs
#  passthrough = dev engine. Runs the real pipeline but does NOT change accent.
#  remote      = your accent-conversion model server (see docs/ENGINE_CONTRACT.md)
#  elevenlabs  = voice swap (replaces your voice with an accented target voice)
ENGINE=passthrough

# remote engine
REMOTE_ENGINE_URL=
REMOTE_ENGINE_KEY=
REMOTE_ENGINE_TIMEOUT_SEC=600

# elevenlabs voice-swap engine
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_sts_v2
# Map accent ids to voice ids from your ElevenLabs library, e.g.
# ELEVENLABS_VOICES=en-GB:voiceIdA,en-AU:voiceIdB,en-US:voiceIdC
ELEVENLABS_VOICES=
